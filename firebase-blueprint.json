{
  "entities": {
    "Message": {
      "title": "Message",
      "description": "A single message in the chat session",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The textual content of the message",
          "maxLength": 10000
        },
        "sender": {
          "type": "string",
          "enum": ["user", "assistant"],
          "description": "Who sent this message"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the message was sent"
        }
      },
      "required": ["text", "sender", "timestamp"]
    },
    "Chat": {
      "title": "Chat",
      "description": "A chat session document",
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When this chat session was initiated"
        }
      },
      "required": ["createdAt"]
    }
  },
  "firestore": {
    "/chats/{session_id}": {
      "schema": "Chat",
      "description": "Root chat document"
    },
    "/chats/{session_id}/messages/{messageId}": {
      "schema": "Message",
      "description": "Subcollection of chat messages"
    }
  }
}

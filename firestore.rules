rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Reusable validation helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function isValidChat(data) {
      return data.keys().hasAll(['createdAt']) && data.keys().size() == 1;
    }
    
    function isValidMessage(data) {
      return data.keys().hasAll(['text', 'sender', 'timestamp']) 
        && data.keys().size() == 3
        && data.text is string
        && data.text.size() <= 10000
        && data.sender is string
        && (data.sender == 'user' || data.sender == 'assistant')
        && data.timestamp is timestamp;
    }

    match /chats/{session_id} {
      // Allow read and write on the chat metadata itself
      allow read, write: if isSignedIn() && isValidId(session_id) && (request.auth.uid == session_id || session_id.matches('^' + request.auth.uid + '.*$'));
      
      match /messages/{messageId} {
        // Users can read messages in their own chat session
        allow read: if isSignedIn() && (request.auth.uid == session_id || session_id.matches('^' + request.auth.uid + '.*$'));
        
        // Users can create messages in their own chat session
        allow create: if isSignedIn() && (request.auth.uid == session_id || session_id.matches('^' + request.auth.uid + '.*$'))
          && isValidMessage(incoming())
          && (incoming().sender == 'user' || incoming().sender == 'assistant');
          
        // Messages are immutable once written; no updates or deletes
        allow update, delete: if false;
      }
    }
  }
}
